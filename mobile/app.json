{
  "expo": {
    "name": "GrandWall",
    "slug": "grandwall-warehouse",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/grandwall-icon.png",
    "scheme": "grandwall",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F2EC",
    "primaryColor": "#8A632B",
    "ios": {
      "icon": "./assets/images/grandwall-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "az.grandwall.warehouse",
      "buildNumber": "1",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "az.grandwall.warehouse",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#B1A18B",
        "foregroundImage": "./assets/images/grandwall-adaptive-foreground.png",
        "backgroundImage": "./assets/images/grandwall-adaptive-background.png",
        "monochromeImage": "./assets/images/grandwall-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/grandwall-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "GrandWall sifarişin sübut şəklini çəkmək üçün kameradan istifadə edir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F2EC",
          "image": "./assets/images/grandwall-wordmark.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "whatsapp"
          ],
          "android": [
            "com.whatsapp",
            "com.whatsapp.w4b"
          ]
        }
      ],
      "expo-build-properties",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
