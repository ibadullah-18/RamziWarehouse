{
    "expo":  {
                 "name":  "Ramzi",
                 "slug":  "grandwall",
                 "version":  "1.1.0",
                 "orientation":  "portrait",
                 "icon":  "./assets/images/grandwall-icon.png",
                 "scheme":  "grandwall",
                 "userInterfaceStyle":  "light",
                 "backgroundColor":  "#F3F6FB",
                 "primaryColor":  "#1D4ED8",
                 "ios":  {
                             "icon":  "./assets/images/grandwall-icon.png",
                             "supportsTablet":  true,
                             "bundleIdentifier":  "az.grandwall.app",
                             "buildNumber":  "11",
                             "infoPlist":  {
                                               "LSApplicationQueriesSchemes":  [
                                                                                   "whatsapp"
                                                                               ]
                                           }
                         },
                 "android":  {
                                 "package":  "az.grandwall.app",
                                 "versionCode":  15,
                                 "adaptiveIcon":  {
                                                      "backgroundColor":  "#B1A18B",
                                                      "foregroundImage":  "./assets/images/grandwall-adaptive-foreground.png",
                                                      "backgroundImage":  "./assets/images/grandwall-adaptive-background.png",
                                                      "monochromeImage":  "./assets/images/grandwall-monochrome.png"
                                                  },
                                 "predictiveBackGestureEnabled":  false,
                                 "softwareKeyboardLayoutMode":  "resize"
                             },
                 "web":  {
                             "output":  "single",
                             "favicon":  "./assets/images/grandwall-favicon.png"
                         },
                 "plugins":  [
                                 "expo-router",
                                 [
                                     "expo-image-picker",
                                     {
                                         "cameraPermission":  "GrandWall sifarişin sübut şəklini çəkmək üçün kameradan istifadə edir.",
                                         "microphonePermission":  false
                                     }
                                 ],
                                 [
                                     "expo-splash-screen",
                                     {
                                         "backgroundColor":  "#F3F6FB",
                                         "image":  "./assets/images/splash-blank.png",
                                         "imageWidth":  280
                                     }
                                 ],
                                 [
                                     "expo-secure-store",
                                     {
                                         "configureAndroidBackup":  true
                                     }
                                 ],
                                 [
                                     "react-native-share",
                                     {
                                         "ios":  [
                                                     "whatsapp"
                                                 ],
                                         "android":  [
                                                         "com.whatsapp",
                                                         "com.whatsapp.w4b"
                                                     ]
                                     }
                                 ],
                                 "expo-build-properties",
                                 "expo-image",
                                 "expo-web-browser",
                                 [
                                     "expo-notifications",
                                     {
                                         "defaultChannel":  "returns"
                                     }
                                 ]
                             ],
                 "experiments":  {
                                     "typedRoutes":  true,
                                     "reactCompiler":  true
                                 },
                 "extra":  {
                               "router":  {

                                          },
                               "eas":  {
                                           "projectId":  "502a7aaf-0107-4234-9d91-d114f7e30915"
                                       }
                           },
                 "owner":  "ibadulla",
                 "description":  "GrandWall mobile release 1.1.0"
             }
}
